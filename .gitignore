node_modules/

# 本插件自身开发时的项目层记忆（改名前的 .dsh-memory/ 一并忽略，便于迁移期共存）
.agent-memory/
.dsh-memory/

# 打包产物与 npm 临时缓存（由 scripts/pack.mjs 生成）
dist/
.npm-cache/
*.tgz

*.tmp-*
*.log
/docs

# 生成物/临时文件（tools/gen-preset-override.mjs 的输出等）
.scratch/

# preset 整段覆盖的生成物（tools/gen-preset-override.mjs --out 的输出）
preset-*-override.yml
